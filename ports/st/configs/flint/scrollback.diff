+static void
+histpush(Line l)
+{
+	term.histi = (term.histi + 1) % HISTSIZE;
+	if (!term.hist[term.histi])
+		term.hist[term.histi] = xmalloc(term.col * sizeof(Glyph));
+	memcpy(term.hist[term.histi], l, term.col * sizeof(Glyph));
+	if (term.histn < HISTSIZE)
+		term.histn++;
+	/* while scrolled back, keep showing the same lines */
+	if (term.scr)
+		term.scr = MIN(term.scr + 1, term.histn);
+}
+
+void
+kscrollup(const Arg *a)
+{
+	int n = a->i > 0 ? a->i : MAX(term.row - 2, 1);
+	int scr = MIN(term.scr + n, term.histn);
+
+	if (IS_SET(MODE_ALTSCREEN) || scr == term.scr)
+		return;
+	selclear();
+	term.scr = scr;
+	tfulldirt();
+}
+
+void
+kscrolldown(const Arg *a)
+{
+	int n = a->i > 0 ? a->i : a->i < 0 ? MAX(term.row - 2, 1) : term.scr;
+	int scr = MAX(term.scr - n, 0);
+
+	if (scr == term.scr)
+		return;
+	selclear();
+	term.scr = scr;
+	tfulldirt();
+}
+
+/* the mouse wheel: scrollback on the main screen; on the alternate screen (less, man)
+ * Ctrl+Y / Ctrl+E as st sends by default */
+void
+kscrollwheel(const Arg *a)
+{
+	if (IS_SET(MODE_ALTSCREEN))
+		ttywrite(a->i > 0 ? "\031" : "\005", 1, 0);
+	else if (a->i > 0)
+		kscrollup(a);
+	else
+		kscrolldown(&(Arg){ .i = -a->i });
+}
