#!/bin/sh
# Super+w in dwm-flint: the first web browser that is installed.
for b in "$BROWSER" firefox librewolf chromium; do
    [ -n "$b" ] && command -v "$b" >/dev/null 2>&1 && exec "$b" "$@"
done
echo "no web browser is installed (pkg install firefox once it is in the repository)" |
    dmenu -p "browser" -nb '#0b0b0c' -nf '#c3ccd8' -sb '#ffc94a' -sf '#0b0b0c' >/dev/null
