#!/bin/sh
# startx: start the X server on this terminal, then a session on it.
#
#   startx               the session in ~/.xinitrc, or /etc/X11/xinit/xinitrc (dwm)
#   startx PROGRAM ARGS  that program instead (st, say)
#   XVT=2 startx         on virtual console 2 (when started from ssh or a serial line)
#
# Flint's Xorg has no udev, so this writes its configuration: the GPU through kernel
# modesetting, and every input device through libinput. The keyboard layout comes from
# XKB_LAYOUT (e.g. XKB_LAYOUT=pl startx), else /etc/X11/xkb-layout, else us.

display=0
while [ -e "/tmp/.X$display-lock" ] || [ -e "/tmp/.X11-unix/X$display" ]; do
    display=$((display + 1))
done

# the virtual console to show it on: this one, or XVT (XVT=2 startx from ssh or a serial line)
tty=$(readlink /proc/self/fd/0 2>/dev/null)
case "${XVT:-}:$tty" in
    [0-9]*:*) vt=${XVT} ;;
    :/dev/tty[0-9]*) vt=${tty#/dev/tty} ;;
    *) echo "startx: run it on a virtual console (tty1, tty2, ...), or set XVT; not on $tty" >&2; exit 1 ;;
esac

# the session: a program to run, ~/.xinitrc, or Flint's default (dwm). Without one X would
# start and sit on a black screen.
if [ $# -eq 0 ] && [ ! -f "$HOME/.xinitrc" ] && ! command -v dwm >/dev/null 2>&1; then
    echo "startx: no window manager installed; install dwm with: pkg config install dwm-1" >&2
    echo "        (or put your own session in ~/.xinitrc, or run: startx PROGRAM)" >&2
    exit 1
fi

layout=${XKB_LAYOUT:-}
[ -z "$layout" ] && [ -r /etc/X11/xkb-layout ] && layout=$(cat /etc/X11/xkb-layout)
[ -z "$layout" ] && layout=us

# keep the terminal when X runs on the one we are on (otherwise Xorg takes over vt$vt)
keeptty=
[ "$tty" = "/dev/tty$vt" ] && keeptty=-keeptty

# the GPU: the card its kernel driver (amdgpu, i915...) made, else the firmware framebuffer
# (simpledrm). The numbers are not fixed: when a GPU driver replaces simpledrm, card0 goes
# away and the GPU is card1. A GPU driver still loading gets 5 seconds. XCARD overrides.
gpu=
fb=
find_cards() {
    gpu=
    fb=
    for c in /dev/dri/card[0-9]*; do
        [ -e "$c" ] || continue
        drv=$(readlink "/sys/class/drm/${c##*/}/device/driver" 2>/dev/null)
        case "${drv##*/}" in
            simple-framebuffer|simpledrm|efi-framebuffer|vesa-framebuffer) [ -z "$fb" ] && fb=$c ;;
            *) [ -z "$gpu" ] && gpu=$c ;;
        esac
    done
}
card=${XCARD:-}
n=0
while [ -z "$card" ]; do
    find_cards
    if [ -n "$gpu" ]; then
        card=$gpu
    elif [ -n "$fb" ] && [ "$n" -ge 5 ]; then
        card=$fb
    elif [ "$n" -ge 10 ]; then
        echo "startx: no graphics device in /dev/dri; is the GPU driver loaded? (lsmod, dmesg)" >&2
        exit 1
    else
        n=$((n + 1))
        sleep 1
    fi
done

state=${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/xorg
mkdir -p "$state"
conf="$state/xorg-$display.conf"
{
    echo 'Section "ServerFlags"'
    echo '    Option "AutoAddDevices" "false"'
    echo '    Option "AutoAddGPU" "false"'
    echo 'EndSection'
    echo 'Section "Device"'
    echo '    Identifier "gpu"'
    echo '    Driver "modesetting"'
    echo "    Option \"kmsdev\" \"$card\""
    echo 'EndSection'
    echo 'Section "Screen"'
    echo '    Identifier "screen"'
    echo '    Device "gpu"'
    echo 'EndSection'
    echo 'Section "InputClass"'
    echo '    Identifier "keyboard layout"'
    echo '    MatchIsKeyboard "on"'
    echo "    Option \"XkbLayout\" \"$layout\""
    echo 'EndSection'
    devices=""
    for dev in /dev/input/event*; do
        [ -e "$dev" ] || continue
        id=${dev##*/}
        echo 'Section "InputDevice"'
        echo "    Identifier \"$id\""
        echo '    Driver "libinput"'
        echo "    Option \"Device\" \"$dev\""
        echo '    Option "XkbRules" "evdev"'   # without hotplugging Xorg would pick "base" (wrong keycodes)
        echo "    Option \"XkbLayout\" \"$layout\""
        echo '    Option "Tapping" "on"'
        echo '    Option "NaturalScrolling" "false"'
        echo 'EndSection'
        devices="$devices $id"
    done
    echo 'Section "ServerLayout"'
    echo '    Identifier "flint"'
    echo '    Screen "screen"'
    for id in $devices; do
        echo "    InputDevice \"$id\" \"SendCoreEvents\""
    done
    echo 'EndSection'
} > "$conf"

# xorg-gl (Mesa's OpenGL, GLX and GPU drivers, run by flint-glibc) brings its own X server;
# when it is installed, it is the better one. XSERVER overrides the choice.
server=${XSERVER:-/usr/bin/Xorg}
[ -z "${XSERVER:-}" ] && [ -x /usr/lib/xorg/Xorg ] && server=/usr/lib/xorg/Xorg
"$server" ":$display" "vt$vt" -config "$conf" $keeptty -noreset -nolisten tcp \
    -logfile "$state/Xorg.$display.log" >/dev/null 2>&1 &
server=$!

# on failure: what went wrong, from the server's log
why() {
    echo "startx: using $card; the X server's errors:" >&2
    grep '] (EE) [A-Za-z]' "$state/Xorg.$display.log" 2>/dev/null | grep -v -e mouse -e kbd \
        -e 'PreInit returned 2 for "<default' -e 'Please also check' | tail -n 10 >&2
    echo "full log: $state/Xorg.$display.log" >&2
}

# Stop the X server. Xorg writes its PID to /tmp/.X$display-lock; in Flint 1.1 and older $!
# is a shell around it rather than Xorg itself, and killing only that left X on the screen.
stop_server() {
    xpid=
    [ -r "/tmp/.X$display-lock" ] && read -r xpid < "/tmp/.X$display-lock"
    kill "$server" 2>/dev/null
    [ -n "$xpid" ] && kill "$xpid" 2>/dev/null
    i=0
    while [ -n "$xpid" ] && kill -0 "$xpid" 2>/dev/null; do
        i=$((i + 1))
        if [ "$i" -gt 10 ]; then
            kill -9 "$xpid" 2>/dev/null
            break
        fi
        sleep 1
    done
    wait "$server" 2>/dev/null
}

# wait for the server's socket
n=0
while [ ! -e "/tmp/.X11-unix/X$display" ]; do
    if ! kill -0 "$server" 2>/dev/null; then
        echo "startx: the X server stopped" >&2
        why
        exit 1
    fi
    n=$((n + 1))
    if [ "$n" -gt 30 ]; then
        echo "startx: the X server did not start in 30 seconds" >&2
        why
        stop_server
        exit 1
    fi
    sleep 1
done

# The session's errors go to a file as well as the terminal: X covers the terminal, so they
# are shown again once X is gone.
export DISPLAY=":$display"
slog="$state/session.$display.log"
if [ $# -gt 0 ]; then
    "$@" 2>"$slog"
elif [ -f "$HOME/.xinitrc" ]; then
    sh "$HOME/.xinitrc" 2>"$slog"
else
    sh /etc/X11/xinit/xinitrc 2>"$slog"
fi
status=$?
stop_server
if [ "$status" -ne 0 ]; then
    echo "startx: the session ended with status $status" >&2
    tail -n 15 "$slog" >&2
    echo "full log: $slog" >&2
fi
exit $status
